 #include <linux/units.h>
+#include <linux/rp1-gpclk-lease.h>
 
 #include <dt-bindings/clock/raspberrypi,rp1-clocks.h>
 
@@ -315,6 +319,9 @@ struct rp1_clockman {
 	void __iomem *regs;
 	struct regmap *regmap;
 	spinlock_t regs_lock; /* spinlock for all clocks */
+	struct mutex gp0_dma_lock;
+	resource_size_t regs_phys;
+	bool gp0_dma_leased;
 
 	/* Must be last */
 	struct clk_hw_onecell_data onecell;
@@ -373,6 +380,94 @@ static struct rp1_clk_desc *clk_audio_core;
 static struct rp1_clk_desc *clk_audio;
 static struct rp1_clk_desc *clk_i2s;
 static struct clk_hw *clk_xosc;
+static struct rp1_clk_desc clk_gp0_desc;
+
+int rp1_gpclk_dma_lease_get(struct clk *clk, struct device *dma_dev,
+	struct rp1_gpclk_dma_lease *lease)
+{
+	struct clk_hw *hw;
+	struct rp1_clockman *clockman;
+	phys_addr_t divider_phys;
+	int ret;
+
+	if (!clk || !dma_dev || !lease)
+		return -EINVAL;
+	hw = __clk_get_hw(clk);
+	if (hw != &clk_gp0_desc.hw)
+		return -EINVAL;
+	clockman = clk_gp0_desc.clockman;
+	if (!clockman)
+		return -ENODEV;
+	if (!mutex_trylock(&clockman->gp0_dma_lock))
+		return -EBUSY;
+	ret = clk_rate_exclusive_get(clk);
+	if (ret)
+		goto unlock;
+	if (clk_hw_is_prepared(hw)) {
+		ret = -EBUSY;
+		goto rate_put;
+	}
+	divider_phys = clockman->regs_phys + CLK_GP0_DIV_FRAC;
+	lease->divider_dma_addr = phys_to_dma(dma_dev, divider_phys);
+	lease->provider_private = clockman;
+	WRITE_ONCE(clockman->gp0_dma_leased, true);
+	return 0;
+
+rate_put:
+	clk_rate_exclusive_put(clk);
+unlock:
+	mutex_unlock(&clockman->gp0_dma_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(rp1_gpclk_dma_lease_get);
+
+void rp1_gpclk_dma_lease_put(struct clk *clk,
+	struct rp1_gpclk_dma_lease *lease)
+{
+	struct rp1_clockman *clockman;
+
+	if (!clk || !lease || !lease->provider_private)
+		return;
+	clockman = lease->provider_private;
+	WRITE_ONCE(clockman->gp0_dma_leased, false);
+	lease->provider_private = NULL;
+	lease->divider_dma_addr = 0;
+	clk_rate_exclusive_put(clk);
+	mutex_unlock(&clockman->gp0_dma_lock);
+}
+EXPORT_SYMBOL_GPL(rp1_gpclk_dma_lease_put);
+
+int rp1_gpclk_dma_lease_configure(struct rp1_gpclk_dma_lease *lease,
+	u32 divider_integer)
+{
+	struct rp1_clockman *clockman;
+
+	if (!lease || !lease->provider_private || divider_integer != 3)
+		return -EINVAL;
+	clockman = lease->provider_private;
+	spin_lock(&clockman->regs_lock);
+	regmap_write(clockman->regmap, CLK_GP0_DIV_INT, divider_integer);
+	spin_unlock(&clockman->regs_lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(rp1_gpclk_dma_lease_configure);
+
+int rp1_gpclk_dma_lease_read(struct rp1_gpclk_dma_lease *lease,
+	u32 *divider_integer, u32 *divider_fractional)
+{
+	struct rp1_clockman *clockman;
+
+	if (!lease || !lease->provider_private || !divider_integer ||
+		!divider_fractional)
+		return -EINVAL;
+	clockman = lease->provider_private;
+	spin_lock(&clockman->regs_lock);
+	regmap_read(clockman->regmap, CLK_GP0_DIV_INT, divider_integer);
+	regmap_read(clockman->regmap, CLK_GP0_DIV_FRAC, divider_fractional);
+	spin_unlock(&clockman->regs_lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(rp1_gpclk_dma_lease_read);
 
