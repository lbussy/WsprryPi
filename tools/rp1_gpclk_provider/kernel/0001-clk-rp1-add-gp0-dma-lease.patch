+
 	spin_lock(&clockman->regs_lock);
 	ctrl = clockman_read(clockman, data->ctrl_reg);
 
@@ -957,6 +1058,9 @@ static int rp1_clock_set_rate_and_parent(struct clk_hw *hw,
 	const struct rp1_clock_data *data = clock->data;
 	u32 div = rp1_clock_choose_div(rate, parent_rate, data);
 
+	if (clock == &clk_gp0_desc && READ_ONCE(clockman->gp0_dma_leased))
+		return -EBUSY;
+
 	spin_lock(&clockman->regs_lock);
 
 	clockman_write(clockman, data->div_int_reg, div >> CLK_DIV_FRAC_BITS);
@@ -2400,6 +2504,7 @@ static int rp1_clk_probe(struct platform_device *pdev)
 	struct rp1_clockman *clockman;
 	struct clk_hw **hws;
 	unsigned int i;
+	struct resource *res;
 
 	clockman = devm_kzalloc(dev, struct_size(clockman, onecell.hws, asize),
 				GFP_KERNEL);
@@ -2407,7 +2512,12 @@ static int rp1_clk_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	spin_lock_init(&clockman->regs_lock);
