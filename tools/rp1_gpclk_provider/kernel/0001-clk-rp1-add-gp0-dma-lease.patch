 	clockman->dev = dev;
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -ENODEV;
+	clockman->regs_phys = res->start;
 
 	clockman->regs = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(clockman->regs))
