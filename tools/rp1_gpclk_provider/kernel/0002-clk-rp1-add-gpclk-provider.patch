diff --git a/drivers/clk/Kconfig b/drivers/clk/Kconfig
index 60b454677..1de9f4cd2 100644
--- a/drivers/clk/Kconfig
+++ b/drivers/clk/Kconfig
@@ -97,6 +97,22 @@ config COMMON_CLK_RP1
 	  This multi-function device has 3 main PLLs and several clock
 	  generators to drive the internal sub-peripherals.
 
+config RP1_GPCLK_PROVIDER
+	tristate "RP1 GPCLK provider-owned tick DMA"
+	depends on COMMON_CLK_RP1 && DMA_ENGINE
+	select MISC_DEVICES
+	help
+	  Expose a versioned, address-independent userspace interface for one
+	  complete 162-symbol WSPR divider sequence. The provider owns the finite
+	  tick-paced DMA submission, GPCLK0 lease, GPIO4 pinctrl selection, pad
+	  drive, and restoration to the safe input state. Live output remains
+	  disabled unless the read-only live_output module parameter is enabled.
+
+config RP1_GPCLK_PROVIDER_KUNIT_TEST
+	tristate "RP1 GPCLK provider contract tests" if !KUNIT_ALL_TESTS
+	depends on KUNIT
+	default KUNIT_ALL_TESTS
+
 config COMMON_CLK_RP1_SDIO
 	tristate "Clock driver for the RP1 SDIO interfaces"
 	depends on MFD_RP1
